# ─── Backend API ──────────────────────────────────────────────────────────────
# Full URL of the FastAPI backend. No trailing slash.
# This is the only variable that changes between deployments.
#
# Examples:
#   Local dev:        http://localhost:8000
#   Vercel + RunPod:  https://abc123.proxy.runpod.net
#   Same server:      http://localhost:8000
#   Custom domain:    https://api.mycompany.com
NEXT_PUBLIC_API_URL=http://localhost:8000

# ─── Request settings ─────────────────────────────────────────────────────────
NEXT_PUBLIC_API_TIMEOUT=30000

# ─── Feature flags ────────────────────────────────────────────────────────────
NEXT_PUBLIC_ENABLE_3D_CANVAS=true
NEXT_PUBLIC_ENABLE_REAL_TIME_STREAMING=true
NEXT_PUBLIC_MOCK_DATA_MODE=true
# Dev mode: skips RunPod wake-up flow so the login form is immediately usable
# locally. Set to false (or remove) for production deployments.
NEXT_PUBLIC_DEV_MODE=false

# ─── Performance ──────────────────────────────────────────────────────────────
NEXT_PUBLIC_TIMELINE_STREAMING_INTERVAL=15000
NEXT_PUBLIC_CHART_ANIMATION_ENABLED=true

# ─── Analytics (optional) ─────────────────────────────────────────────────────
NEXT_PUBLIC_ANALYTICS_ID=
NEXT_PUBLIC_SENTRY_DSN=
