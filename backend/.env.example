# ─────────────────────────────────────────────────────────────────────────────
# Tripolar Backend — Environment Variables
# Copy to .env and fill in values before deploying.
# In RunPod: set these as Pod Environment Variables in the UI.
# ─────────────────────────────────────────────────────────────────────────────

# Database — use the RunPod network volume path so data persists
DATABASE_URL=sqlite:////runpod-volume/tripolar.db

# Auth — generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me-to-a-random-64-char-hex-string

# CORS — comma-separated, no trailing slash
# Add your Vercel deployment URL
ALLOWED_ORIGINS=https://your-app.vercel.app,http://localhost:3000

# Optional: allow all Vercel preview deployments
# ALLOW_ORIGIN_REGEX=https://.*\.vercel\.app

# HuggingFace token (required for gated models like Llama 3)
# HUGGING_FACE_HUB_TOKEN=hf_...

# Logging
LOG_LEVEL=INFO
LOG_FORMAT=json
