# ─── Database ────────────────────────────────────────────────────────────────
DATABASE_URL=sqlite:///./tripolar.db
# PostgreSQL example:
# DATABASE_URL=postgresql+asyncpg://user:password@host:5432/dbname

# ─── Auth ─────────────────────────────────────────────────────────────────────
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# ─── Logging ──────────────────────────────────────────────────────────────────
LOG_LEVEL=INFO
LOG_FORMAT=text

# ─── CORS ─────────────────────────────────────────────────────────────────────
# Comma-separated list of allowed frontend origins. No trailing slashes.
# Add every origin that will call this API (dev, staging, prod, preview, etc).
#
# Examples:
#   Local dev:        http://localhost:3000
#   Vercel prod:      https://myapp.vercel.app
#   Custom domain:    https://app.mycompany.com
#   RunPod / Lambda:  https://abc123.proxy.runpod.net
ALLOWED_ORIGINS=http://localhost:3000

# Optional regex for dynamic preview origins (e.g. Vercel branch previews,
# platform-generated subdomains). Leave empty if not needed.
# The operator sets this to whatever pattern their cloud provider uses.
#
# Examples:
#   Vercel previews: https://myapp-[a-z0-9]+-myteam\.vercel\.app
#   Generic subdomain: https://[a-z0-9-]+\.mycompany\.com
ALLOW_ORIGIN_REGEX=
